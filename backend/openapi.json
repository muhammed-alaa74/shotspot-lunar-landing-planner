            "title": "Minsun"
          },
          "minEarth": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Minearth"
          },
          "maxSunGap": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 8760.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Maxsungap"
          },
          "maxEarthGap": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 8760.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Maxearthgap"
          },
          "maxSlope": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 90.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Maxslope"
          },
          "conservative": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
