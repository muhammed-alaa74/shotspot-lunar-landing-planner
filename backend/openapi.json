          "driftM": {
            "type": "number",
            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Driftm"
          },
          "arrivalDelayDays": {
            "type": "number",
            "maximum": 365.0,
            "minimum": 0.0,
            "title": "Arrivaldelaydays"
