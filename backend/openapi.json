      "GoToStepAction": {
        "properties": {
          "type": {
            "type": "string",
            "const": "go_to_step",
            "title": "Type"
          },
          "payload": {
            "$ref": "#/components/schemas/GoToStepPayload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "payload"
        ],
        "title": "GoToStepAction"
      },
      "GoToStepPayload": {
        "properties": {
          "step": {
            "type": "string",
            "enum": [
              "aim",
              "drift",
              "better-aim",
              "move",
              "explore"
            ],
            "title": "Step"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "step"
        ],
        "title": "GoToStepPayload"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message"
      },
      "OpenCompareAction": {
        "properties": {
          "type": {
            "type": "string",
            "const": "open_compare",
            "title": "Type"
          },
          "payload": {
            "$ref": "#/components/schemas/OpenComparePayload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "payload"
        ],
        "title": "OpenCompareAction"
      },
      "OpenCompareItem": {
        "properties": {
          "site": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Site"
          },
          "startDate": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Startdate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "site",
          "startDate"
        ],
        "title": "OpenCompareItem"
      },
      "OpenComparePayload": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OpenCompareItem"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 2,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "OpenComparePayload"
