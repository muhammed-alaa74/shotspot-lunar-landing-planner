          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Profile"
              },
              {
                "type": "null"
              }
            ]
          },
          "aimIndex": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
