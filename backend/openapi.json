{
  "openapi": "3.1.0",
  "info": {
    "title": "SHOTSPOT Copilot API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/copilot": {
      "post": {
        "tags": [
          "copilot"
        ],
        "summary": "Copilot",
        "operationId": "copilot_api_copilot_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CopilotRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CopilotResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/copilot/sites": {
      "get": {
        "tags": [
          "copilot"
        ],
        "summary": "Sites",
        "operationId": "sites_api_copilot_sites_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SitesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Context": {
        "properties": {
          "site": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ],
            "title": "Site"
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "durationDays": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 365.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Durationdays"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Profile"
              },
              {
                "type": "null"
              }
            ]
          },
          "driftM": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 500.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Driftm"
          },
          "aimIndex": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Aimindex"
          },
          "arrivalDelayDays": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 365.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Arrivaldelaydays"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Context"
      },
      "CopilotRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Messages"
          },
          "context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Context"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "CopilotRequest"
      },
      "CopilotResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "actions": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SetScenarioAction"
                },
                {
                  "$ref": "#/components/schemas/OpenCompareAction"
                },
                {
                  "$ref": "#/components/schemas/GoToStepAction"
                }
              ]
            },
            "type": "array",
            "title": "Actions"
          },
          "toolCalls": {
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "type": "array",
            "title": "Toolcalls"
          },
          "verified": {
            "type": "boolean",
            "title": "Verified"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reply",
          "verified"
