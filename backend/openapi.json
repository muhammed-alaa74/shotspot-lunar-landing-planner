          "defaults": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Defaults"
          },
          "glossary": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Glossary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sites"
        ],
        "title": "SitesResponse"
      },
      "ToolCall": {
        "properties": {
          "tool": {
            "type": "string",
