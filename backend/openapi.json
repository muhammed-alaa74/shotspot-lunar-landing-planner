          "minEarthPct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Minearthpct"
          },
          "maxEarthOutageH": {
            "type": "number",
            "maximum": 8760.0,
            "minimum": 0.0,
            "title": "Maxearthoutageh"
